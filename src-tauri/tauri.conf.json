{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT 账号管家",
  "version": "0.2.21",
  "identifier": "com.lampese.codex-switcher",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "ChatGPT 账号管家",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyOEJGNDE3RTJFQzVBOTMKUldTVFd1emlGL1NMb2tIWVQ1UTJHWGJXMCsyMnJXUm5Db25sQnJYNGZOaGh6VU8rVW8yTk1VOXIK",
      "endpoints": [
        "https://github.com/coding-ai-cyber/chatgpt-account-hub/releases/latest/download/latest.json"
      ]
    }
  }
}
